---
import BaseLayout from '../layouts/BaseLayout.astro';
import NewsletterForm from '../components/NewsletterForm.astro';

const title = 'Our Ranking Methodology - How We Find the Best-Rated Products';
const description = 'Learn exactly how Boring Best ranks everyday products. We mine real Amazon customer reviews and ratings to surface the options buyers rate highest.';
---

<BaseLayout 
  title={title}
  description={description}
  breadcrumbs={[{ label: 'Methodology' }]}
>
  <section class="py-12">
    <h1 class="text-4xl font-bold text-gray-900 mb-6">Our Ranking Methodology</h1>
    
    <p class="text-xl text-gray-700 mb-12">
      We believe in a simple, honest promise: <strong>we rank products by what real buyers actually say</strong>. Here is exactly how we do it.
    </p>
    
    <!-- Phase 1 -->
    <div class="mb-16">
      <div class="flex items-center gap-4 mb-6">
        <div class="w-12 h-12 bg-[#2563EB] text-white rounded-full flex items-center justify-center font-bold text-xl">1</div>
        <h2 class="text-2xl font-bold text-gray-900">Choose What to Review</h2>
      </div>
      
      <div class="ml-16 prose max-w-none text-gray-700">
        <p class="mb-4">
          We pick everyday household categories that people actually search for and routinely buy — the "boring stuff" nobody likes researching.
        </p>
        
        <h3 class="text-lg font-semibold text-gray-900 mt-6 mb-3">Our Selection Criteria:</h3>
        <ul class="list-disc pl-6 mb-6 space-y-2">
          <li><strong>Everyday relevance:</strong> Products most households own or need (plungers, liners, cords, dish racks, trash cans).</li>
          <li><strong>Repeated purchase decisions:</strong> Categories where buyers genuinely struggle to choose.</li>
          <li><strong>Info asymmetry:</strong> Products where marketing hype makes honest comparison valuable.</li>
        </ul>
      </div>
    </div>
    
    <!-- Phase 2 -->
    <div class="mb-16">
      <div class="flex items-center gap-4 mb-6">
        <div class="w-12 h-12 bg-[#2563EB] text-white rounded-full flex items-center justify-center font-bold text-xl">2</div>
        <h2 class="text-2xl font-bold text-gray-900">Discover the Top-Rated Products</h2>
      </div>
      
      <div class="ml-16 prose max-w-none text-gray-700">
        <p class="mb-4">
          We surface the top-rated products in the category from Amazon. These are the products real buyers have actually purchased and rated in volume.
        </p>
        
        <h3 class="text-lg font-semibold text-gray-900 mt-6 mb-3">What We Record:</h3>
        <ul class="list-disc pl-6 mb-6 space-y-2">
          <li>Product name, ASIN, and current price</li>
          <li>Real Amazon star rating</li>
          <li>Product type and design</li>
          <li>What use case each product is best suited for</li>
        </ul>
        
        <h3 class="text-lg font-semibold text-gray-900 mt-6 mb-3">Selection Criteria:</h3>
        <ul class="list-disc pl-6 mb-6 space-y-2">
          <li><strong>Volume of ratings:</strong> We prefer products with enough verified reviews to be statistically meaningful.</li>
          <li><strong>Rating spread:</strong> We include budget, mid-range, and premium options in every guide.</li>
          <li><strong>Design variety:</strong> We include different designs and approaches so every use case is covered.</li>
        </ul>
      </div>
    </div>
    
    <!-- Phase 3 -->
    <div class="mb-16">
      <div class="flex items-center gap-4 mb-6">
        <div class="w-12 h-12 bg-[#2563EB] text-white rounded-full flex items-center justify-center font-bold text-xl">3</div>
        <h2 class="text-2xl font-bold text-gray-900">Mine the Reviews</h2>
      </div>
      
      <div class="ml-16 prose max-w-none text-gray-700">
        <p class="mb-4">
          This is where the real work happens. We read through substantial numbers of verified customer reviews to understand what buyers consistently praise and complain about.
        </p>
        
        <h3 class="text-lg font-semibold text-gray-900 mt-6 mb-3">What We Look For:</h3>
        <ul class="list-disc pl-6 mb-6 space-y-2">
          <li><strong>Consistent praise:</strong> What do happy buyers repeatedly highlight?</li>
          <li><strong>Consistent complaints:</strong> What flaws keep showing up in negative and lower-star reviews?</li>
          <li><strong>Recurring themes:</strong> Durability, ease of use, materials, and long-term performance as reported by owners.</li>
          <li><strong>Buyer context:</strong> We note which use cases specific products serve best.</li>
        </ul>
        
        <p>
          We report what real buyers say and let verified ratings speak for themselves.
        </p>
      </div>
    </div>
    
    <!-- Phase 4 -->
    <div class="mb-16">
      <div class="flex items-center gap-4 mb-6">
        <div class="w-12 h-12 bg-[#2563EB] text-white rounded-full flex items-center justify-center font-bold text-xl">4</div>
        <h2 class="text-2xl font-bold text-gray-900">Match Products to Use Cases</h2>
      </div>
      
      <div class="ml-16 prose max-w-none text-gray-700">
        <p class="mb-4">
          "Best" depends on context. The same product type has different winners for different needs and budgets.
        </p>
        
        <h3 class="text-lg font-semibold text-gray-900 mt-6 mb-3">How We Shape a Guide:</h3>
        <ul class="list-disc pl-6 mb-6 space-y-2">
          <li><strong>Best Overall:</strong> The best balance of rating, price, and durability for most people.</li>
          <li><strong>Best Budget:</strong> The best performer at the lowest cost.</li>
          <li><strong>Best for Specific Needs:</strong> Design, capacity, material, or aesthetics winners.</li>
          <li><strong>Runners-Up:</strong> Solid options we considered and why they did not win their slot.</li>
        </ul>
      </div>
    </div>
    
    <!-- Phase 5 -->
    <div class="mb-16">
      <div class="flex items-center gap-4 mb-6">
        <div class="w-12 h-12 bg-[#2563EB] text-white rounded-full flex items-center justify-center font-bold text-xl">5</div>
        <h2 class="text-2xl font-bold text-gray-900">Present Findings Honestly</h2>
      </div>
      
      <div class="ml-16 prose max-w-none text-gray-700">
        <p class="mb-4">
          We write plain-language guides that present each product's real rating, price, and the pros and cons buyers report. We are transparent about our method on every page.
        </p>
        
        <h3 class="text-lg font-semibold text-gray-900 mt-6 mb-3">Our Writing Standards:</h3>
        <ul class="list-disc pl-6 mb-6 space-y-2">
          <li><strong>Transparency:</strong> Each guide states that rankings come from real Amazon reviews.</li>
          <li><strong>Honesty:</strong> We report real downsides, not just glowing praise.</li>
          <li><strong>Clarity:</strong> We write for regular people.</li>
          <li><strong>Sourced data:</strong> Every rating and price comes from real Amazon listings and buyer reviews.</li>
        </ul>
      </div>
    </div>
    
    <!-- Phase 6 -->
    <div class="mb-16">
      <div class="flex items-center gap-4 mb-6">
        <div class="w-12 h-12 bg-[#2563EB] text-white rounded-full flex items-center justify-center font-bold text-xl">6</div>
        <h2 class="text-2xl font-bold text-gray-900">Keep Guides Current</h2>
      </div>
      
      <div class="ml-16 prose max-w-none text-gray-700">
        <p class="mb-4">
          Products, prices, and ratings change. We keep our guides honest by refreshing them.
        </p>
        
        <h3 class="text-lg font-semibold text-gray-900 mt-6 mb-3">Update Schedule:</h3>
        <ul class="list-disc pl-6 mb-6 space-y-2">
          <li><strong>Monthly:</strong> Price and availability checks.</li>
          <li><strong>Quarterly:</strong> Look for new products gaining strong positive ratings in covered categories.</li>
          <li><strong>As Needed:</strong> Immediate updates if a safety issue emerges for a recommended product.</li>
        </ul>
      </div>
    </div>
    
    <!-- Our Commitments -->
    <div class="bg-gray-50 rounded-xl p-8 my-12">
      <h2 class="text-2xl font-bold text-gray-900 mb-6">Our Commitments to You</h2>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="text-center">
          <div class="w-16 h-16 bg-[#2563EB] bg-opacity-10 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#2563EB" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            </svg>
          </div>
          <h3 class="font-bold text-gray-900 mb-2">100% Honest</h3>
          <p class="text-sm text-gray-600">Buyer-sourced. Every ranking comes from real Amazon customer reviews and ratings.</p>
        </div>
        
        <div class="text-center">
          <div class="w-16 h-16 bg-[#2563EB] bg-opacity-10 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#2563EB" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"></path>
              <circle cx="12" cy="12" r="3"></circle>
            </svg>
          </div>
          <h3 class="font-bold text-gray-900 mb-2">Buyer-Sourced</h3>
          <p class="text-sm text-gray-600">Every ranking is grounded in real customer ratings and verified reviews.</p>
        </div>
        
        <div class="text-center">
          <div class="w-16 h-16 bg-[#2563EB] bg-opacity-10 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#2563EB" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
              <circle cx="12" cy="12" r="3"></circle>
            </svg>
          </div>
          <h3 class="font-bold text-gray-900 mb-2">Full Transparency</h3>
          <p class="text-sm text-gray-600">We show you our method, the ratings, and the honest downsides real buyers reported.</p>
        </div>
      </div>
    </div>
    
    <!-- Questions -->
    <div class="my-12">
      <h2 class="text-2xl font-bold text-gray-900 mb-4">Questions About Our Process?</h2>
      <p class="text-gray-700 mb-6">
        We are happy to explain our ranking method in more detail. Contact us at <a href="mailto:hello@boringbest.com" class="text-[#2563EB] hover:underline">hello@boringbest.com</a>
      </p>
    </div>
  </section>
  
  <!-- Newsletter -->
  <section class="py-12 border-t border-gray-200">
    <NewsletterForm 
      variant="hero"
      title="Get Guides You Can Trust"
      description="Weekly best-rated guides for everyday essentials, ranked the honest way."
    />
  </section>
</BaseLayout>