---
import BaseLayout from '../layouts/BaseLayout.astro';
import NewsletterForm from '../components/NewsletterForm.astro';

const title = 'About Boring Best - How We Rank the Best-Rated Products';
const description = 'We rank the boring stuff you actually need by digging through real Amazon customer reviews. Learn about our mission, our honest process, and why we will never fake a lab test.';
---

<BaseLayout 
  title={title}
  description={description}
  breadcrumbs={[{ label: 'About Us' }]}
>
  <section class="py-12">
    <h1 class="text-4xl font-bold text-gray-900 mb-6">About Boring Best</h1>
    
    <div class="prose max-w-none text-gray-700">
      <p class="text-xl mb-8">
        We find the best-rated boring stuff so you do not have to. From toilet plungers to extension cords, we dig through real Amazon customer reviews to rank the everyday products you actually need — honest, buyer-sourced recommendations.
      </p>
      
      <h2 class="text-2xl font-bold text-gray-900 mt-12 mb-4">Our Mission</h2>
      <p class="mb-4">
        Every day, millions of people buy mundane household products without research. They grab the cheapest option or the first one they see, then live with products that break, underperform, or frustrate them for years.
      </p>
      <p class="mb-4">
        We believe boring products deserve better research. You should not have to spend 10 hours reading reviews of toilet plungers or shower curtain liners. That is our job.
      </p>
      <p class="mb-8">
        Our mission is simple: <strong>Rank the best everyday products by what real buyers actually say, then tell you exactly what to buy.</strong>
      </p>
      
      <h2 class="text-2xl font-bold text-gray-900 mt-12 mb-4">Our Values</h2>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 my-8">
        <div class="bg-gray-50 p-6 rounded-lg">
          <h3 class="font-bold text-gray-900 mb-2">100% Honest</h3>
          <p class="text-gray-600">Every recommendation is ranked from real Amazon customer ratings and reviews.</p>
        </div>
        
        <div class="bg-gray-50 p-6 rounded-lg">
          <h3 class="font-bold text-gray-900 mb-2">Buyer-Sourced Data</h3>
          <p class="text-gray-600">We rank products by mining thousands of real customer reviews so you know what real buyers think.</p>
        </div>
        
        <div class="bg-gray-50 p-6 rounded-lg">
          <h3 class="font-bold text-gray-900 mb-2">Transparent Method</h3>
          <p class="text-gray-600">We explain exactly how we rank and why. We show the star ratings and the pros and cons real buyers report. No black box.</p>
        </div>
        
        <div class="bg-gray-50 p-6 rounded-lg">
          <h3 class="font-bold text-gray-900 mb-2">Value Focused</h3>
          <p class="text-gray-600">We care about durability and price — we look for the products buyers trust to last, not the ones with the best marketing.</p>
        </div>
      </div>
      
      <h2 class="text-2xl font-bold text-gray-900 mt-12 mb-4">Who We Are</h2>
      <p class="mb-4">
        Boring Best is run by a small, independent researcher who was tired of buying terrible products. There is a careful, consistent process for turning real customer reviews into honest rankings.
      </p>
      <p class="mb-8">
        That honesty is the whole point. We rank products by what thousands of real buyers reported, and we tell you exactly how we did it.
      </p>
      
      <h2 class="text-2xl font-bold text-gray-900 mt-12 mb-4">Our Ranking Process</h2>
      <p class="mb-4">
        Every guide follows the same honest process:
      </p>
      <ol class="list-decimal pl-6 mb-8 space-y-3">
        <li><strong>Product discovery:</strong> We pull the top-rated products in a category from Amazon.</li>
        <li><strong>Rating analysis:</strong> We record each product's real Amazon star rating.</li>
        <li><strong>Review mining:</strong> We read through verified buyer reviews to find consistent pros, cons, and complaints.</li>
        <li><strong>Use-case matching:</strong> We match the best option to common situations and budgets.</li>
        <li><strong>Write-up:</strong> We present the rankings honestly, including real downsides.</li>
        <li><strong>Updates:</strong> We revisit guides to keep prices and picks current.</li>
      </ol>
      <p class="mb-8">
        Read the full details on our <a href="/methodology/" class="text-[#2563EB] hover:underline">methodology page</a>.
      </p>
      
      <h2 class="text-2xl font-bold text-gray-900 mt-12 mb-4">Affiliate Disclosure</h2>
      <p class="mb-4">
        Boring Best is a participant in the Amazon Services LLC Associates Program, an affiliate advertising program designed to provide a means for sites to earn advertising fees by advertising and linking to Amazon.com.
      </p>
      <p class="mb-4">
        When you purchase a product through one of our links, we may earn a small commission. This comes at no extra cost to you.
      </p>
      <p class="mb-8">
        <strong>Important:</strong> Our rankings come from real Amazon customer ratings and reviews. Affiliate relationships never influence our recommendations, and we do not take payment from manufacturers for positioning.
      </p>
      
      <h2 class="text-2xl font-bold text-gray-900 mt-12 mb-4">Contact Us</h2>
      <p class="mb-4">
        Have questions, suggestions, or feedback? We would love to hear from you.
      </p>
      <p class="mb-8">
        Email us at: <a href="mailto:hello@boringbest.com" class="text-[#2563EB] hover:underline">hello@boringbest.com</a>
      </p>
    </div>
  </section>
  
  <!-- Newsletter -->
  <section class="py-12 border-t border-gray-200">
    <NewsletterForm 
      variant="hero"
      title="Never Miss a Guide"
      description="Get weekly best-rated buying guides for everyday essentials delivered to your inbox."
    />
  </section>
</BaseLayout>