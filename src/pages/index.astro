---
import BaseLayout from '../layouts/BaseLayout.astro';
import TrustBar from '../components/TrustBar.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import ReviewCard from '../components/ReviewCard.astro';

const featuredReviews = [
  {
    title: 'Best Toilet Plungers',
    description: 'The top-rated toilet plungers on Amazon, ranked by real customer reviews. Our picks all hold 4.4★ or higher across thousands of ratings.',
    category: 'Bathroom',
    slug: 'best-toilet-plungers',
    rating: 4.4,
    badge: 'Top Pick',
    image: '/images/korky-99-4A.png'
  },
  {
    title: 'Best Shower Curtain Liners',
    description: 'The highest-rated shower curtain liners on Amazon, judged on mold resistance and value by thousands of real buyers.',
    category: 'Bathroom',
    slug: 'best-shower-curtain-liners',
    rating: 4.3,
    badge: 'Best Value'
  },
  {
    title: 'Best Extension Cords',
    description: 'The best-rated extension cords and surge protectors on Amazon, ranked by safety records and real customer feedback.',
    category: 'Home Office',
    slug: 'best-extension-cords',
    rating: 4.5,
    badge: 'Top Pick'
  }
];

const categories = [
  { name: 'Bathroom', slug: 'bathroom', count: 2 },
  { name: 'Kitchen', slug: 'kitchen', count: 0 },
  { name: 'Home Office', slug: 'home-office', count: 1 },
  { name: 'Home Improvement', slug: 'home-improvement', count: 0 },
  { name: 'Laundry', slug: 'laundry', count: 0 },
];

const schema = {
  '@type': 'WebPage',
  name: 'Boring Best - Best-Rated Everyday Essentials',
  description: 'We rank the boring stuff by digging through real Amazon customer reviews. Honest, buyer-sourced recommendations of everyday household products.',
  url: 'https://boringbest.com',
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: featuredReviews.map((review, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      item: {
        '@type': 'Article',
        headline: review.title,
        description: review.description,
        url: `https://boringbest.com/reviews/${review.slug}/`
      }
    }))
  }
};
---

<BaseLayout
  title="Boring Best - Best-Rated Everyday Essentials"
  description="We rank the boring stuff you actually need by digging through real Amazon customer reviews. Honest, buyer-sourced buying guides for everyday essentials."
  schema={schema}
>
  <!-- Hero Section -->
  <section class="py-16 md:py-24 text-center">
    <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-gray-900 mb-6 mx-auto leading-tight px-4">
      We Rank the <span class="text-[#2563EB]">Boring Stuff</span><br class="hidden md:block" /> So You Don't Have To
    </h1>
    <p class="text-xl text-gray-600 mx-auto mb-8 px-4" style="max-width: 100%;">
      No mystery labs. No unverifiable "we tested it" claims. We dig through thousands of real Amazon customer reviews to find the highest-rated everyday essentials &mdash; then tell you exactly what to buy.
    </p>

    <!-- Trust Bar -->
    <TrustBar
      lastUpdated="2026-02-08"
    />

    <!-- Quick Stats -->
    <div class="flex flex-wrap justify-center gap-8 mt-8 text-center">
      <div>
        <div class="text-3xl font-bold text-[#2563EB]">4.3&#9733;+</div>
        <div class="text-sm text-gray-600">Every pick buyer-rated</div>
      </div>
      <div>
        <div class="text-3xl font-bold text-[#2563EB]">9</div>
        <div class="text-sm text-gray-600">Top Picks Ranked</div>
      </div>
      <div>
        <div class="text-3xl font-bold text-[#2563EB]">5</div>
        <div class="text-sm text-gray-600">Categories Covered</div>
      </div>
      <div>
        <div class="text-3xl font-bold text-[#2563EB]">0</div>
        <div class="text-sm text-gray-600">Manufacturer influence</div>
      </div>
    </div>
  </section>

  <!-- Featured Reviews -->
  <section class="py-16">
    <h2 class="text-3xl font-bold text-gray-900 mb-2">Latest Guides</h2>
    <p class="text-gray-600 mb-8">Our highest-rated recommendations, ranked from real Amazon reviews</p>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {featuredReviews.map((review) => (
        <ReviewCard
          title={review.title}
          description={review.description}
          category={review.category}
          slug={review.slug}
          rating={review.rating}
          badge={review.badge}
          image={review.image}
        />
      ))}
    </div>
  </section>

  <!-- Browse by Category -->
  <section class="py-16 border-t border-gray-200">
    <h2 class="text-3xl font-bold text-gray-900 mb-2">Browse by Category</h2>
    <p class="text-gray-600 mb-8">Find guides by room or use case</p>

    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4">
      {categories.map((category) => (
        <a
          href={`/categories/${category.slug}/`}
          class="group bg-gray-50 hover:bg-blue-50 border border-gray-200 hover:border-[#2563EB] rounded-xl p-6 text-center transition-all"
        >
          <h3 class="font-semibold text-gray-900 group-hover:text-[#2563EB] transition-colors">
            {category.name}
          </h3>
          <p class="text-sm text-gray-500 mt-1">
            {category.count > 0 ? `${category.count} guide${category.count === 1 ? '' : 's'}` : 'Coming soon'}
          </p>
        </a>
      ))}
    </div>
  </section>

  <!-- Newsletter Section -->
  <section class="py-16">
    <NewsletterForm
      variant="hero"
      title="Never Waste Money on a Bad Buy Again"
      description="New best-rated buying guides for everyday essentials, delivered weekly. Zero hype, zero fake lab claims."
    />
  </section>

  <!-- Trust Section -->
  <section class="py-16 border-t border-gray-200">
    <div class="mx-auto text-center max-w-5xl px-4">
      <h2 class="text-3xl font-bold text-gray-900 mb-6">Why Trust Boring Best?</h2>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mt-8">
        <div>
          <div class="w-12 h-12 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#2563EB" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"></path>
              <circle cx="12" cy="12" r="3"></circle>
            </svg>
          </div>
          <h3 class="font-semibold text-gray-900 mb-2">Real Reviews, Not a Fake Lab</h3>
          <p class="text-sm text-gray-600">We rank products by mining real Amazon customer ratings and feedback &mdash; honestly.</p>
        </div>

        <div>
          <div class="w-12 h-12 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#2563EB" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            </svg>
          </div>
          <h3 class="font-semibold text-gray-900 mb-2">No Manufacturer Influence</h3>
          <p class="text-sm text-gray-600">Recommendations come from what real buyers report &mdash; not what brands pay to say.</p>
        </div>

        <div>
          <div class="w-12 h-12 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#2563EB" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
              <line x1="16" y1="13" x2="8" y2="13"></line>
              <line x1="16" y1="17" x2="8" y2="17"></line>
              <polyline points="10 9 9 9 8 9"></polyline>
            </svg>
          </div>
          <h3 class="font-semibold text-gray-900 mb-2">Full Transparency</h3>
          <p class="text-sm text-gray-600">We show our work &mdash; star ratings, prices, and how we ranked each pick.</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>