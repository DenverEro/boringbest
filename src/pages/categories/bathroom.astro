---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ReviewCard from '../../components/ReviewCard.astro';
import TrustBar from '../../components/TrustBar.astro';
import NewsletterForm from '../../components/NewsletterForm.astro';

const title = 'Best Bathroom Products 2026 - Reviews & Buying Guides';
const description = 'Best-rated bathroom essentials including toilet plungers, shower curtains, and liners, ranked by real Amazon customer reviews.';

const reviews = [
  {
    title: 'Best Shower Curtains',
    slug: 'best-shower-curtains',
    description: 'The best-rated fabric shower curtains, ranked by real customer reviews on feel, mildew resistance, and value.',
    category: 'Bathroom',
    rating: 4.7,
    image: '/images/best-shower-curtains-B087JH5Q4H.jpg'
  },
  {
    title: 'Best Shower Curtain Liners',
    slug: 'best-shower-curtain-liners',
    description: 'The best-rated shower curtain liners, ranked by real customer reviews on mold resistance and value.',
    category: 'Bathroom',
    rating: 4.6,
    image: '/images/best-shower-curtain-liners-B00LS9UD2M.jpg'
  },
  {
    title: 'Best Toilet Plungers',
    slug: 'best-toilet-plungers',
    description: 'The top-rated toilet plungers, ranked by real Amazon customer reviews.',
    category: 'Bathroom',
    rating: 4.6,
    image: '/images/best-toilet-plungers-B07GTHXKF3.jpg'
  }
];

const comingSoon = [
  'Shower Caddies',
  'Toilet Brushes',
  'Bath Mats',
  'Soap Dispensers',
  'Toilet Paper Holders'
];

const breadcrumbs = [
  { label: 'Categories', href: '/categories/' },
  { label: 'Bathroom' }
];
---

<BaseLayout 
  title={title}
  description={description}
  breadcrumbs={breadcrumbs}
>
  <section class="py-12">
    <h1 class="text-4xl font-bold text-gray-900 mb-4">Bathroom Reviews</h1>
    <p class="text-xl text-gray-600 mb-8 max-w-3xl">
      Best-rated bathroom essentials. We rank products by digging through real Amazon customer reviews, so you can buy with confidence.
    </p>
    
    <TrustBar 
      lastUpdated="2026-09-06"
    />
  </section>
  
  <!-- Published Reviews -->
  <section class="py-8">
    <h2 class="text-2xl font-bold text-gray-900 mb-6">Published Reviews</h2>
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {reviews.map((review) => (
        <ReviewCard
          title={review.title}
          description={review.description}
          category={review.category}
          slug={review.slug}
          rating={review.rating}
          image={review.image}
        />
      ))}
    </div>
  </section>
  
  <!-- Coming Soon -->
  <section class="py-8 border-t border-gray-200">
    <h2 class="text-2xl font-bold text-gray-900 mb-6">Reviews Coming Soon</h2>
    <div class="flex flex-wrap gap-3">
      {comingSoon.map((item) => (
        <span class="inline-flex items-center px-4 py-2 bg-gray-100 text-gray-700 font-medium rounded-full">
          {item}
        </span>
      ))}
    </div>
    <p class="text-gray-600 mt-4">
      Want to know when we publish these reviews? <a href="/newsletter/" class="text-[#2563EB] hover:underline">Subscribe to our newsletter</a>.
    </p>
  </section>
  
  <!-- Newsletter -->
  <section class="py-12 border-t border-gray-200">
    <NewsletterForm 
      variant="inline"
      title="Get Bathroom Reviews First"
      description="Be the first to know when we publish new best-rated bathroom reviews."
    />
  </section>
</BaseLayout>