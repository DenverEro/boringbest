---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NewsletterForm from '../../components/NewsletterForm.astro';

const title = 'Best Kitchen Products 2026 - Reviews & Buying Guides';
const description = 'Best-rated kitchen essentials including dish racks, trash cans, and more. Ranked by real Amazon customer reviews.';

const comingSoon = [
  'Dish Racks',
  'Kitchen Trash Cans',
  'Sponge Holders',
  'Sink Strainers',
  'Cabinet Organizers',
  'Paper Towel Holders',
  'Dish Brushes'
];

const breadcrumbs = [
  { label: 'Categories', href: '/categories/' },
  { label: 'Kitchen' }
];
---

<BaseLayout 
  title={title}
  description={description}
  breadcrumbs={breadcrumbs}
>
  <section class="py-12">
    <h1 class="text-4xl font-bold text-gray-900 mb-4">Kitchen Guides</h1>
    <p class="text-xl text-gray-600 mb-8 max-w-3xl">
      Best-rated kitchen essentials. We rank products by digging through real Amazon customer reviews, and we are writing new guides now.
    </p>
  </section>
  
  <!-- Guides Coming Soon -->
  <section class="py-8 border-t border-gray-200">
    <h2 class="text-2xl font-bold text-gray-900 mb-6">Guides Coming Soon</h2>
    <div class="flex flex-wrap gap-3">
      {comingSoon.map((item) => (
        <span class="inline-flex items-center px-4 py-2 bg-gray-100 text-gray-700 font-medium rounded-full">
          {item}
        </span>
      ))}
    </div>
    <p class="text-gray-600 mt-4">
      Want to know when we publish these guides? <a href="/newsletter/" class="text-[#2563EB] hover:underline">Subscribe to our newsletter</a>.
    </p>
  </section>
  
  <!-- Newsletter -->
  <section class="py-12 border-t border-gray-200">
    <NewsletterForm 
      variant="inline"
      title="Get Kitchen Guides First"
      description="Be the first to know when we publish new best-rated kitchen guides."
    />
  </section>
</BaseLayout>