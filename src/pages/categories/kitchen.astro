---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ReviewCard from '../../components/ReviewCard.astro';
import NewsletterForm from '../../components/NewsletterForm.astro';

const title = 'Best Kitchen Products 2026 - Reviews & Buying Guides';
const description = 'Best-rated kitchen essentials including dish racks and kitchen trash cans, ranked by real Amazon customer reviews.';

const reviews = [
  {
    title: 'Best Dish Drying Racks',
    slug: 'best-dish-racks',
    description: 'The best-rated dish drying racks, ranked by real customer ratings on durability, size, and value.',
    category: 'Kitchen',
    rating: 4.6,
    image: '/images/best-dish-racks-B0FF4KTKZL.jpg'
  },
  {
    title: 'Best Kitchen Trash Cans',
    slug: 'best-kitchen-trash-cans',
    description: 'The best-rated kitchen trash cans, ranked by real customer reviews on lid design, capacity, and value.',
    category: 'Kitchen',
    rating: 4.5,
    image: '/images/best-kitchen-trash-cans-B07KPZ1DR3.jpg'
  }
];

const comingSoon = [
  'Sponge Holders',
  'Sink Strainers',
  'Cabinet Organizers',
  'Paper Towel Holders',
  'Dish Brushes'
];

const breadcrumbs = [
  { label: 'Categories', href: '/categories/' },
  { label: 'Kitchen' }
];
---

<BaseLayout 
  title={title}
  description={description}
  breadcrumbs={breadcrumbs}
>
  <section class="py-12">
    <h1 class="text-4xl font-bold text-gray-900 mb-4">Kitchen Guides</h1>
    <p class="text-xl text-gray-600 mb-8 max-w-3xl">
      Best-rated kitchen essentials. We rank products by digging through real Amazon customer reviews, so you can buy with confidence.
    </p>
  </section>
  
  <!-- Published Guides -->
  <section class="py-8">
    <h2 class="text-2xl font-bold text-gray-900 mb-6">Published Reviews</h2>
    
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {reviews.map((review) => (
        <ReviewCard
          title={review.title}
          description={review.description}
          category={review.category}
          slug={review.slug}
          rating={review.rating}
          image={review.image}
        />
      ))}
    </div>
  </section>
  
  <!-- Coming Soon -->
  <section class="py-8 border-t border-gray-200">
    <h2 class="text-2xl font-bold text-gray-900 mb-6">Guides Coming Soon</h2>
    <div class="flex flex-wrap gap-3">
      {comingSoon.map((item) => (
        <span class="inline-flex items-center px-4 py-2 bg-gray-100 text-gray-700 font-medium rounded-full">
          {item}
        </span>
      ))}
    </div>
  </section>
  
  <!-- Newsletter -->
  <section class="py-12 border-t border-gray-200">
    <NewsletterForm 
      variant="inline"
      title="Get Kitchen Guides First"
      description="Be the first to know when we publish new best-rated kitchen guides."
    />
  </section>
</BaseLayout>