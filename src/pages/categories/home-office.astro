---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ReviewCard from '../../components/ReviewCard.astro';
import TrustBar from '../../components/TrustBar.astro';
import NewsletterForm from '../../components/NewsletterForm.astro';

const title = 'Best Home Office Products 2026 - Reviews & Buying Guides';
const description = 'Best-rated home office essentials including extension cords and power strips, ranked by real Amazon customer reviews.';

const reviews = [
  {
    title: 'Best Power Strips',
    slug: 'best-power-strips',
    description: 'The best-rated power strips and surge protectors, ranked by real customer reviews on surge protection and value.',
    category: 'Home Office',
    rating: 4.8,
    image: '/images/best-power-strips-B08Z2ZKVXX.jpg'
  },
  {
    title: 'Best Extension Cords',
    slug: 'best-extension-cords',
    description: 'The best-rated extension cords and surge protectors, ranked by real customer feedback on safety and reliability.',
    category: 'Home Office',
    rating: 4.8,
    image: '/images/best-extension-cords-B076KFTPWM.jpg'
  }
];

const comingSoon = [
  'Cable Organizers',
  'Desk Lamps',
  'Monitor Stands',
  'USB Hubs'
];

const breadcrumbs = [
  { label: 'Categories', href: '/categories/' },
  { label: 'Home Office' }
];
---

<BaseLayout 
  title={title}
  description={description}
  breadcrumbs={breadcrumbs}
>
  <section class="py-12">
    <h1 class="text-4xl font-bold text-gray-900 mb-4">Home Office Reviews</h1>
    <p class="text-xl text-gray-600 mb-8 max-w-3xl">
      Best-rated home office essentials. We rank products by digging through real Amazon customer reviews, so you can work with confidence.
    </p>
    
    <TrustBar 
      lastUpdated="2026-09-06"
    />
  </section>
  
  <!-- Published Guides -->
  <section class="py-8">
    <h2 class="text-2xl font-bold text-gray-900 mb-6">Published Reviews</h2>
    
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {reviews.map((review) => (
        <ReviewCard
          title={review.title}
          description={review.description}
          category={review.category}
          slug={review.slug}
          rating={review.rating}
          image={review.image}
        />
      ))}
    </div>
  </section>
  
  <!-- Coming Soon -->
  <section class="py-8 border-t border-gray-200">
    <h2 class="text-2xl font-bold text-gray-900 mb-6">Guides Coming Soon</h2>
    <div class="flex flex-wrap gap-3">
      {comingSoon.map((item) => (
        <span class="inline-flex items-center px-4 py-2 bg-gray-100 text-gray-700 font-medium rounded-full">
          {item}
        </span>
      ))}
    </div>
    <p class="text-gray-600 mt-4">
      Want to know when we publish these guides? <a href="/newsletter/" class="text-[#2563EB] hover:underline">Subscribe to our newsletter</a>.
    </p>
  </section>
  
  <!-- Newsletter -->
  <section class="py-12 border-t border-gray-200">
    <NewsletterForm 
      variant="inline"
      title="Get Home Office Guides First"
      description="Be the first to know when we publish new best-rated home office guides."
    />
  </section>
</BaseLayout>