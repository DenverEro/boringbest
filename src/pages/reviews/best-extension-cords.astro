---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TrustBar from '../../components/TrustBar.astro';
import SortableTable from '../../components/SortableTable.astro';
import PickCard from '../../components/PickCard.astro';
import NewsletterForm from '../../components/NewsletterForm.astro';

const title = 'Best Extension Cords of 2026: Ranked by Real Reviews';
const description = 'The best-rated extension cords and surge protectors on Amazon, ranked by safety records and real customer feedback. Find the right gauge and length for home, office, or outdoor use.';
const publishedDate = '2026-01-18';
const lastUpdated = '2026-02-08';

const products = [
  {
    name: 'Amazon Basics 6-Outlet Surge Protector',
    price: 12.99,
    rating: 4.8,
    type: 'Indoor',
    bestFor: 'Home Office',
    verdict: 'Best overall with surge protection, 6 outlets, and 6-foot cord at an unbeatable price.',
    buyLink: 'https://amazon.com/dp/B00TP1C51M?tag=boringbest-20',
    buyText: 'Check Price'
  },
  {
    name: 'Iron Forge Cable 100-Foot Outdoor Cord',
    price: 39.99,
    rating: 4.7,
    type: 'Outdoor',
    bestFor: 'Yard Work',
    verdict: 'Heavy-duty 12/3 cord that handles power tools and outdoor equipment safely.',
    buyLink: 'https://amazon.com/dp/B01N3RPUVT?tag=boringbest-20',
    buyText: 'Check Price'
  },
  {
    name: 'Cordinate Designer 3-Outlet Extension Cord',
    price: 9.99,
    rating: 4.5,
    type: 'Indoor',
    bestFor: 'Style & Function',
    verdict: 'Stylish woven fabric cord with 3 outlets and 8-foot reach. Great for visible areas.',
    buyLink: 'https://amazon.com/dp/B01MTQ7KY7?tag=boringbest-20',
    buyText: 'Check Price'
  },
  {
    name: 'US Wire & Cable 50-Foot Heavy Duty',
    price: 34.99,
    rating: 4.6,
    type: 'Outdoor',
    bestFor: 'Medium Duty',
    verdict: 'Flexible cold-weather cord that stays pliable in freezing temperatures.',
    buyLink: 'https://amazon.com/dp/B000FPAN3A?tag=boringbest-20',
    buyText: 'Check Price'
  },
  {
    name: 'Belkin 12-Outlet Power Strip',
    price: 24.99,
    rating: 4.7,
    type: 'Indoor',
    bestFor: 'High Capacity',
    verdict: 'Maximum outlets with 3940-joule surge protection and coaxial protection.',
    buyLink: 'https://amazon.com/dp/B000J2EN4S?tag=boringbest-20',
    buyText: 'Check Price'
  }
];

const faqs = [
  {
    question: 'What gauge extension cord do I need?',
    answer: 'For most household use (lamps, chargers, small appliances), 16-gauge is sufficient. For power tools, heaters, or outdoor use, use 14-gauge or 12-gauge. The lower the gauge number, the thicker the wire and the more power it can safely handle. Always check the amp rating of your device and match it to the cord capacity.'
  },
  {
    question: 'Can you plug an extension cord into another extension cord?',
    answer: 'No, this is called "daisy-chaining" and is a fire hazard. It can overload the circuit and cause overheating. If you need more reach, use one longer cord rated for your power needs instead of connecting multiple shorter cords.'
  },
  {
    question: 'Are outdoor extension cords safe in rain?',
    answer: 'Outdoor-rated cords (marked with "W" for water-resistant) are designed for outdoor use but should still be protected from standing water. Look for cords with grounded (3-prong) plugs, heavy-duty jackets, and keep connections elevated off the ground. Never use indoor cords outdoors.'
  },
  {
    question: 'How long can an extension cord be?',
    answer: 'Extension cords come in lengths from 1 foot to 100+ feet. However, longer cords have more resistance and voltage drop. For high-power devices, keep cords under 50 feet when possible. If you must use a longer cord, use a heavier gauge (12 or 10) to compensate for the distance.'
  },
  {
    question: 'Do extension cords wear out?',
    answer: 'Yes, extension cords degrade over time. Inspect cords regularly for damage: frayed insulation, exposed wires, cracked plugs, or loose connections. Replace cords every 3-5 years with regular use, or immediately if damaged. Store cords loosely coiled in a dry place to extend their life.'
  }
];

const breadcrumbs = [
  { label: 'Reviews', href: '/categories/' },
  { label: 'Home Office', href: '/categories/home-office/' },
  { label: 'Extension Cords' }
];

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: 'https://boringbest.com/reviews/best-extension-cords/',
  datePublished: publishedDate,
  dateModified: lastUpdated,
  author: {
    '@type': 'Organization',
    name: 'Boring Best'
  },
  publisher: {
    '@type': 'Organization',
    name: 'Boring Best',
    logo: {
      '@type': 'ImageObject',
      url: 'https://boringbest.com/images/logo.png'
    }
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': 'https://boringbest.com/reviews/best-extension-cords/'
  }
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(faq => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer
    }
  }))
};

const schema = [articleSchema, faqSchema];
---

<BaseLayout 
  title={title}
  description={description}
  type="article"
  publishedDate={publishedDate}
  modifiedDate={lastUpdated}
  schema={{ '@graph': schema }}
  breadcrumbs={breadcrumbs}
>
  <!-- Quick Answer -->
  <section class="py-8">
    <div class="bg-blue-50 border-l-4 border-[#2563EB] p-6 rounded-r-lg">
      <h2 class="text-lg font-bold text-gray-900 mb-2">Quick Answer</h2>
      <p class="text-gray-700">
        The <strong>Amazon Basics 6-Outlet Surge Protector</strong> is the highest-rated pick for most home and office use, holding a 4.8&#9733; Amazon rating. Buyers value its 6 grounded outlets, 790-joule surge protection, and 6-foot cord at an unbeatable $12.99. For outdoor work, reviewers consistently favor the Iron Forge 100-foot heavy-duty cord.
      </p>
    </div>
  </section>

  <!-- Trust Bar -->
  <TrustBar 
    lastUpdated={lastUpdated}
  />

  <!-- Safety Notice -->
  <section class="py-4">
    <div class="bg-yellow-50 border-l-4 border-yellow-500 p-4 rounded-r-lg">
      <h3 class="font-bold text-yellow-800 mb-2 flex items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"></path>
          <line x1="12" y1="9" x2="12" y2="13"></line>
          <line x1="12" y1="17" x2="12.01" y2="17"></line>
        </svg>
        Important Safety Information
      </h3>
      <p class="text-yellow-800 text-sm">
        Extension cords can overheat and cause fires if misused. Never exceed the amp rating, never use damaged cords, and never run cords under rugs or through walls. Our top picks all meet or exceed UL safety standards. We rank them by real buyer feedback on safety and reliability.
      </p>
    </div>
  </section>

  <!-- How We Chose These -->
  <section class="py-8 border-b border-gray-200">
    <h2 class="text-2xl font-bold text-gray-900 mb-4">How We Chose These Cords</h2>
    <div class="prose max-w-none text-gray-700">
      <p class="mb-4">
        We rank products the honest way: <strong>by digging through real Amazon customer reviews, safety records, and buyer complaints</strong>. Here is our process:
      </p>
      <ul class="list-disc pl-6 mb-4 space-y-2">
        <li><strong>Star-rating analysis:</strong> We surface the top-rated cords and surge protectors and note their real Amazon ratings.</li>
        <li><strong>Safety verification:</strong> We confirm each pick carries a legitimate UL or ETL certification — drawn from the product listing, not assumed.</li>
        <li><strong>Review reading:</strong> We read verified buyer reviews to surface consistent complaints (overheating, stiff cold-weather cords, flimsy plugs) and consistent praise.</li>
        <li><strong>Use-case matching:</strong> We rank the best pick for home office, yard work, style, medium duty, and high capacity.</li>
      </ul>
      <p>
        Each product's rating below is its <strong>real Amazon rating</strong> — a reflection of what real buyers reported, not our own hands-on testing.
      </p>
    </div>
  </section>

  <!-- Who This Is For -->
  <section class="py-8 border-b border-gray-200">
    <h2 class="text-2xl font-bold text-gray-900 mb-4">Who This Is For</h2>
    <p class="text-gray-700 mb-4">
      This guide is for anyone who needs safe, reliable extension cords for home, office, or outdoor use. Whether you are powering a computer setup, yard tools, or holiday lights, we have ranked options for every situation and safety requirement.
    </p>
    <p class="text-gray-700">
      We focused on UL-listed cords that meet strict safety standards. All our picks are suitable for continuous use at their rated capacity.
    </p>
  </section>

  <!-- Comparison Table -->
  <section class="py-8">
    <h2 class="text-2xl font-bold text-gray-900 mb-4">Compare the Best Extension Cords</h2>
    <p class="text-gray-600 mb-6">
      Click column headers to sort by price, rating, or type. All prices current as of {new Date(lastUpdated).toLocaleDateString('en-US', { month: 'long', year: 'numeric' })}. Ratings are real Amazon customer ratings.
    </p>
    <SortableTable products={products} />
  </section>

  <!-- Top Picks -->
  <section class="py-8">
    <h2 class="text-2xl font-bold text-gray-900 mb-6">Our Top Picks</h2>
    
    <div class="space-y-8">
      <PickCard
        rank={1}
        name="Amazon Basics 6-Outlet Surge Protector"
        price={12.99}
        rating={4.8}
        verdict="The Amazon Basics surge protector is the most-loved pick for most people, holding a 4.8&#9733; Amazon rating. It provides 6 grounded outlets, 790-joule surge protection, and a 6-foot cord at an unbeatable price. Buyers praise its stable, dependable performance and reset button, and the compact design fits easily behind furniture."
        pros={[
          '6 outlets with surge protection',
          '790-joule surge rating',
          '6-foot cord length',
          'UL listed for safety',
          'Circuit breaker reset button',
          'Excellent value at $12.99'
        ]}
        cons={[
          'Not for outdoor use',
          'Cord is not braided/fabric',
          'Outlets are close together',
          'No USB ports'
        ]}
        buyLink="https://amazon.com/dp/B00TP1C51M?tag=boringbest-20"
        buyText="Check Price on Amazon"
        badge="Best Overall"
      />
      
      <PickCard
        rank={2}
        name="Iron Forge Cable 100-Foot Outdoor Cord"
        price={39.99}
        rating={4.7}
        verdict="The best-rated outdoor extension cord for yard work and heavy-duty applications. The 12/3 gauge wire safely handles 15 amps, and buyers consistently praise the heavy-duty vinyl jacket for resisting abrasion and weather. The bright yellow color makes it easy to spot in grass, and reviewers report it stays reliable after seasons of outdoor use."
        pros={[
          'Heavy-duty 12/3 gauge wire',
          '100-foot reach',
          'Rated for -40°F to 140°F',
          'Water-resistant vinyl jacket',
          'Reinforced strain relief',
          'Lighted end shows power status'
        ]}
        cons={[
          'Heavy to carry (8.5 lbs)',
          'Stiff when cold (softens with use)',
          'Premium price',
          'Not for permanent installation'
        ]}
        buyLink="https://amazon.com/dp/B01N3RPUVT?tag=boringbest-20"
        buyText="Check Price on Amazon"
        badge="Best Outdoor"
      />
      
      <PickCard
        rank={3}
        name="Belkin 12-Outlet Power Strip"
        price={24.99}
        rating={4.7}
        verdict="If you need maximum outlets for a home office or entertainment center, the Belkin is the most-recommended high-capacity option. With 12 outlets and 3940-joule surge protection, it can handle an entire desk setup. Buyers particularly value the widely spaced outlets that accommodate large power bricks, and the 8-foot cord for placement flexibility."
        pros={[
          '12 outlets (8 spaced for large plugs)',
          '3940-joule surge protection',
          '8-foot cord',
          'Coaxial and telephone protection',
          'Sliding safety covers',
          '$40,000 connected equipment warranty'
        ]}
        cons={[
          'Large footprint (12.5 inches)',
          'No USB charging ports',
          'Higher price point',
          'Not for outdoor use'
        ]}
        buyLink="https://amazon.com/dp/B000J2EN4S?tag=boringbest-20"
        buyText="Check Price on Amazon"
        badge="Best Capacity"
      />
    </div>
  </section>

  <!-- Buying Guide -->
  <section class="py-8 border-t border-gray-200">
    <h2 class="text-2xl font-bold text-gray-900 mb-4">Extension Cord Buying Guide</h2>
    
    <div class="prose max-w-none text-gray-700">
      <h3 class="text-xl font-semibold text-gray-900 mt-6 mb-3">Understanding Wire Gauges</h3>
      <p class="mb-4">
        Wire gauge determines how much power a cord can safely carry. Lower numbers mean thicker wire:
      </p>
      
      <div class="bg-gray-50 p-4 rounded-lg my-4">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-gray-300">
              <th class="text-left py-2">Gauge</th>
              <th class="text-left py-2">Max Amps</th>
              <th class="text-left py-2">Best For</th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-b border-gray-200">
              <td class="py-2 font-semibold">16</td>
              <td class="py-2">13 amps</td>
              <td class="py-2">Lamps, chargers, small electronics</td>
            </tr>
            <tr class="border-b border-gray-200">
              <td class="py-2 font-semibold">14</td>
              <td class="py-2">15 amps</td>
              <td class="py-2">Power tools, appliances, medium loads</td>
            </tr>
            <tr class="border-b border-gray-200">
              <td class="py-2 font-semibold">12</td>
              <td class="py-2">15-20 amps</td>
              <td class="py-2">Heavy power tools, heaters, outdoor use</td>
            </tr>
            <tr>
              <td class="py-2 font-semibold">10</td>
              <td class="py-2">20+ amps</td>
              <td class="py-2">High-power equipment, industrial use</td>
            </tr>
          </tbody>
        </table>
      </div>
      
      <h3 class="text-xl font-semibold text-gray-900 mt-6 mb-3">Key Safety Features</h3>
      <ul class="list-disc pl-6 mb-4 space-y-2">
        <li><strong>UL or ETL listing:</strong> Ensures the cord meets safety standards. Never buy unlisted cords.</li>
        <li><strong>Grounded (3-prong):</strong> Essential for safety with power tools and electronics.</li>
        <li><strong>Proper gauge:</strong> Match the wire gauge to your device's amp draw.</li>
        <li><strong>Strain relief:</strong> Prevents wire damage at the plug connections.</li>
        <li><strong>Weather rating:</strong> Outdoor cords should be marked with "W" for water resistance.</li>
      </ul>
      
      <h3 class="text-xl font-semibold text-gray-900 mt-6 mb-3">What to Avoid</h3>
      <ul class="list-disc pl-6 mb-4 space-y-2">
        <li><strong>Damaged cords:</strong> Frayed insulation or exposed wires are fire hazards. Replace immediately.</li>
        <li><strong>Overloading:</strong> Never exceed the cord's amp rating. Calculate total device draw before plugging in.</li>
        <li><strong>Indoor cords outdoors:</strong> Indoor cords lack weather protection and can shock or short in moisture.</li>
        <li><strong>Running under rugs:</strong> Heat buildup under rugs can cause fires. Use cord covers instead.</li>
        <li><strong>Daisy-chaining:</strong> Never plug extension cords into each other. Use one properly sized cord.</li>
      </ul>
    </div>
  </section>

  <!-- Care & Maintenance -->
  <section class="py-8 border-t border-gray-200">
    <h2 class="text-2xl font-bold text-gray-900 mb-4">Care & Maintenance</h2>
    <div class="prose max-w-none text-gray-700">
      <p class="mb-4">
        Extend the life of your extension cords and stay safe with these tips:
      </p>
      <ul class="list-disc pl-6 mb-4 space-y-2">
        <li><strong>Inspect regularly:</strong> Check for cuts, fraying, or exposed wires before each use.</li>
        <li><strong>Coil properly:</strong> Use the over-under technique to prevent kinks and wire damage.</li>
        <li><strong>Store indoors:</strong> Keep cords dry and away from direct sunlight when not in use.</li>
        <li><strong>Clean contacts:</strong> Wipe plugs with a dry cloth to ensure good connections.</li>
        <li><strong>Replace old cords:</strong> Replace cords every 3-5 years or sooner if damaged.</li>
        <li><strong>Unroll fully:</strong> For high-power use, unroll the entire cord to prevent heat buildup.</li>
      </ul>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="py-8 border-t border-gray-200">
    <h2 class="text-2xl font-bold text-gray-900 mb-6">Frequently Asked Questions</h2>
    
    <div class="space-y-4">
      {faqs.map((faq, index) => (
        <div class="border border-gray-200 rounded-lg overflow-hidden" itemscope itemprop="mainEntity" itemtype="https://schema.org/Question">
          <h3 class="text-lg font-semibold text-gray-900 p-4 bg-gray-50" itemprop="name">
            {faq.question}
          </h3>
          <div class="p-4 text-gray-700" itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
            <div itemprop="text">
              {faq.answer}
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Newsletter -->
  <section class="py-8 border-t border-gray-200">
    <NewsletterForm 
      variant="inline"
      title="Want More Home Safety Guides?"
      description="Get weekly best-rated buying guides for everyday essentials delivered to your inbox."
    />
  </section>

  <!-- Affiliate Disclosure -->
  <div class="bg-gray-100 rounded-lg p-4 mt-8 text-sm text-gray-600">
    <strong>Affiliate Disclosure:</strong> Boring Best is a participant in the Amazon Services LLC Associates Program, an affiliate advertising program designed to provide a means for sites to earn advertising fees by advertising and linking to Amazon.com. We may earn a commission when you purchase products through our links. Recommendations are based on real Amazon customer ratings and reviews, not on any manufacturer or affiliate relationship.
  </div>
</BaseLayout>