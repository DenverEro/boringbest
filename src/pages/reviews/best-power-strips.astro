---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NewsletterForm from '../../components/NewsletterForm.astro';

const title = 'Best Power Strips of 2026: Guide Coming Soon';
const description = 'We are researching the best-rated power strips and surge protectors on Amazon right now. Join the list and we will let you know the moment this guide publishes.';
const publishedDate = '2026-01-08';
const lastUpdated = '2026-02-08';

const breadcrumbs = [
  { label: 'Reviews', href: '/categories/' },
  { label: 'Home Office', href: '/categories/home-office/' },
  { label: 'Power Strips' }
];
---

<BaseLayout 
  title={title}
  description={description}
  type="article"
  publishedDate={publishedDate}
  modifiedDate={lastUpdated}
  breadcrumbs={breadcrumbs}
>
  <section class="py-12 text-center">
    <h1 class="text-4xl font-bold text-gray-900 mb-4">{title}</h1>
    <p class="text-xl text-gray-600 max-w-3xl mx-auto">
      {description}
    </p>
  </section>
  
  <section class="py-12">
    <div class="bg-blue-50 border border-blue-200 rounded-xl p-8 text-center">
      <h2 class="text-2xl font-bold text-gray-900 mb-4">This Guide Is Being Written</h2>
      <p class="text-gray-700 mb-6">
        We are digging through real Amazon reviews to rank the best-rated power strips. Join our newsletter and we will notify you the moment it is published.
      </p>
      <NewsletterForm 
        variant="inline"
        title="Get Notified When This Guide Publishes"
        description="Be first to read our best-rated power strip picks, ranked from real customer reviews."
      />
    </div>
  </section>
  
  <!-- Affiliate Disclosure -->
  <div class="bg-gray-100 rounded-lg p-4 mt-8 text-sm text-gray-600">
    <strong>Affiliate Disclosure:</strong> Boring Best is a participant in the Amazon Services LLC Associates Program, an affiliate advertising program designed to provide a means for sites to earn advertising fees by advertising and linking to Amazon.com.
  </div>
</BaseLayout>